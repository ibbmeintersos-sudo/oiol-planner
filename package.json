{
  "name": "oiol-planner",
  "version": "0.5.0",
  "private": false,
  "type": "module",
  "description": "Planning-only intelligent engineering system with deterministic plan validation and portable handoff",
  "keywords": [
    "planning",
    "engineering-plan",
    "architecture-review",
    "static-analysis",
    "code-review",
    "llm",
    "cli"
  ],
  "author": "Mohammed Shahrah",
  "homepage": "https://github.com/ibbmeintersos-sudo/oiol-planner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibbmeintersos-sudo/oiol-planner.git"
  },
  "bugs": {
    "url": "https://github.com/ibbmeintersos-sudo/oiol-planner/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "oiol": "src/bin.mjs"
  },
  "files": [
    "src/",
    "schemas/",
    "examples/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "plan": "node src/cli.mjs",
    "init": "node src/bin.mjs init",
    "doctor": "node src/bin.mjs doctor",
    "report": "node src/bin.mjs report",
    "benchmark:planner": "node scripts/run-planner-benchmark.mjs",
    "benchmark:aggregate": "node scripts/aggregate-benchmark-runs.mjs",
    "benchmark:human-review": "node scripts/aggregate-human-reviews.mjs",
    "benchmark:opencode": "node scripts/run-opencode-baseline.mjs",
    "benchmark:compare": "node scripts/compare-benchmark-modes.mjs",
    "benchmark:compare:aggregate": "node scripts/aggregate-paired-comparisons.mjs",
    "benchmark:series": "node scripts/run-benchmark-series.mjs",
    "benchmark:scanner": "node scripts/run-scanner-accuracy-benchmark.mjs",
    "release:check": "node scripts/check-release.mjs",
    "benchmark:change-impact": "node scripts/run-change-impact-benchmark.mjs",
    "benchmark:real-world:validate": "node scripts/validate-real-world-corpus.mjs",
    "benchmark:real-world": "node scripts/run-real-world-benchmark.mjs",
    "benchmark:real-world:intake": "node scripts/validate-real-world-intake.mjs",
    "benchmark:real-world:worklist": "node scripts/validate-annotation-worklist.mjs",
    "benchmark:real-world:review": "node scripts/validate-independent-review.mjs",
    "benchmark:scan-external": "node scripts/run-external-corpus-scan.mjs"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@xberg-io/tree-sitter-language-pack-wasm": "1.25.0"
  }
}
