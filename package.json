{
  "name": "oiol-planner",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "description": "Hybrid planning and validation layer for OpenCode workflows",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "check": "find src scripts -type f -name '*.mjs' -print0 | xargs -0 -n1 node --check",
    "plan": "node src/cli.mjs",
    "smoke:opencode": "node scripts/opencode-smoke.mjs",
    "benchmark:planner": "node scripts/run-planner-benchmark.mjs",
    "benchmark:aggregate": "node scripts/aggregate-benchmark-runs.mjs",
    "benchmark:opencode": "node scripts/run-opencode-baseline.mjs"
  },
  "license": "MIT"
}
