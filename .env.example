# Planning model: openai-compatible, anthropic, gemini, or ollama
OIOL_PROVIDER=openai-compatible
OIOL_MODEL=gpt-4o-mini
OIOL_BASE_URL=https://api.openai.com/v1
OIOL_API_KEY=
OIOL_TIMEOUT_MS=60000
OIOL_MAX_RETRIES=2

# Optional independent reviewer. Without this, plans remain needs_revision.
OIOL_REVIEW_PROVIDER=
OIOL_REVIEW_MODEL=
OIOL_REVIEW_BASE_URL=
OIOL_REVIEW_API_KEY=
OIOL_REVIEW_TIMEOUT_MS=60000

# OpenCode planning-only baseline benchmark (evaluation tooling only)
OIOL_OPENCODE_URL=http://127.0.0.1:4096
OIOL_OPENCODE_USERNAME=opencode
OIOL_OPENCODE_PASSWORD=
OIOL_OPENCODE_AGENT=plan
# Explicit providerID/modelID is required for a live baseline comparison.
OIOL_OPENCODE_MODEL=
OIOL_OPENCODE_TIMEOUT_MS=600000

# Benchmark safeguards. Live calls require setting OIOL_BENCHMARK_ALLOW_LIVE=1.
OIOL_BENCHMARK_ALLOW_LIVE=
# Set the same values for paired OpenCode and OIOL runs only after verifying parity.
OIOL_BENCHMARK_COMPARISON_KEY=
OIOL_BENCHMARK_BUDGET_KEY=
