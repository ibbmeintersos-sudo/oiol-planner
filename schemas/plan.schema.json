{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oiol:schemas:plan:1.0.0",
  "title": "OIOL Engineering Plan",
  "description": "Portable planning artifact. It describes proposed engineering work and does not represent execution state.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "status",
    "project",
    "requirements",
    "architecture",
    "tasks",
    "dependencyGraph",
    "risks",
    "clarifications"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "contractVersion": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ready_for_review",
        "needs_revision",
        "blocked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "project": {
      "type": "object"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "architecture": {
      "type": "object",
      "required": [
        "components",
        "decisions"
      ],
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "dataFlows": {
          "type": "array"
        },
        "alternatives": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "dependencyGraph": {
      "type": "object",
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      },
      "additionalProperties": true
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "clarifications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clarification"
      }
    },
    "review": {
      "type": [
        "object",
        "null"
      ]
    },
    "validation": {
      "type": "object"
    },
    "evaluation": {
      "type": "object"
    },
    "taskInterfaces": {
      "type": "array"
    },
    "traceability": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    },
    "assumptions": {
      "type": "array"
    },
    "unknowns": {
      "type": "array"
    },
    "constraints": {
      "type": "array"
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "required": [
        "id",
        "statement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string"
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "category": {
          "type": "string",
          "enum": [
            "functional",
            "non_functional",
            "constraint",
            "business_rule",
            "quality_attribute"
          ]
        },
        "sourceEvidenceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interfaces": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "decision": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "alternatives": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "title",
        "requirementIds",
        "componentIds",
        "dependencies",
        "acceptanceCriteria",
        "writeScope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "requirementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "componentIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "writeScope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            ]
          }
        },
        "verification": {
          "type": "object"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "fromTaskId",
              "outputName"
            ],
            "properties": {
              "fromTaskId": {
                "type": "string",
                "minLength": 1
              },
              "outputName": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true,
      "not": {
        "anyOf": [
          {
            "required": [
              "status"
            ]
          },
          {
            "required": [
              "execution"
            ]
          },
          {
            "required": [
              "executionState"
            ]
          },
          {
            "required": [
              "startedAt"
            ]
          },
          {
            "required": [
              "completedAt"
            ]
          },
          {
            "required": [
              "attempt"
            ]
          },
          {
            "required": [
              "result"
            ]
          },
          {
            "required": [
              "verified"
            ]
          },
          {
            "required": [
              "verificationStatus"
            ]
          }
        ]
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "type": {
          "const": "finish_to_start"
        }
      },
      "additionalProperties": true
    },
    "risk": {
      "type": "object",
      "required": [
        "description"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "mitigation": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        }
      },
      "additionalProperties": true
    },
    "clarification": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "blocking": {
          "type": "boolean"
        },
        "resolved": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "not": {
    "anyOf": [
      {
        "required": [
          "execution"
        ]
      },
      {
        "required": [
          "executionState"
        ]
      },
      {
        "required": [
          "executionRun"
        ]
      },
      {
        "required": [
          "runId"
        ]
      },
      {
        "required": [
          "executionId"
        ]
      }
    ]
  }
}
