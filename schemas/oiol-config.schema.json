{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oiol:schemas:config:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "defaultProfile": {
      "type": "string",
      "minLength": 1
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^.+$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "model"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "openai-compatible",
                "anthropic",
                "gemini",
                "ollama"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "baseUrl": {
              "type": "string",
              "minLength": 1
            },
            "apiKeyEnv": {
              "type": "string",
              "minLength": 1
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1000
            },
            "maxRetries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "reviewer": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": [
                    "openai-compatible",
                    "anthropic",
                    "gemini",
                    "ollama"
                  ]
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "baseUrl": {
                  "type": "string",
                  "minLength": 1
                },
                "apiKeyEnv": {
                  "type": "string",
                  "minLength": 1
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1000
                }
              },
              "required": [
                "provider",
                "model"
              ]
            }
          }
        }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxFiles": {
          "type": "integer",
          "minimum": 1
        },
        "maxFileBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxPriorityFileBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxContextChars": {
          "type": "integer",
          "minimum": 1
        },
        "maxPriorityExcerptChars": {
          "type": "integer",
          "minimum": 1
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1
        },
        "maxSourceFiles": {
          "type": "integer",
          "minimum": 1
        },
        "maxTestFiles": {
          "type": "integer",
          "minimum": 1
        },
        "maxConfigFiles": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "json",
            "md"
          ]
        },
        "directory": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}