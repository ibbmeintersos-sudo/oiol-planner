      },
      {
        "id": "risk-gil-release-reentrancy",
        "severity": "medium",
        "rationale": "Releasing the GIL during synchronous C++ device discovery or context creation may allow concurrent Python threads to mutate shared interpreter state, causing race conditions or crashes if the C++ code re-enters Python APIs."
      }
